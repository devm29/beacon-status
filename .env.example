# Shared by every service. Ports match the local development setup.
# docker compose reads this file too and runs the services with NODE_ENV=production, which refuses
# the development secrets below: replace REALTIME_SECRET, REVALIDATE_SECRET and CHAOS_ADMIN_TOKEN
# with random values (openssl rand -hex 32) before `docker compose up`.
NODE_ENV=development
LOG_LEVEL=info
MONGO_URL=mongodb://127.0.0.1:27111/beacon
REDIS_URL=redis://127.0.0.1:6411
RAW_RETENTION_DAYS=14
# The demo probes services on localhost. Turn this off to block private, loopback and
# link-local targets (cloud metadata endpoints included) for monitors and webhooks.
ALLOW_PRIVATE_TARGETS=true

# API
API_PORT=8111
CORS_ORIGINS=http://localhost:3111,http://127.0.0.1:3111
REALTIME_SECRET=dev-realtime-secret-change-me
PUBLIC_WEB_URL=http://localhost:3111
WEB_REVALIDATE_URL=http://localhost:3111/api/revalidate
REVALIDATE_SECRET=dev-revalidate-secret
PUBLIC_RATE_LIMIT_PER_MINUTE=300
AUTH_FAILURES_PER_15_MINUTES=50
SSE_MAX_PER_IP=20
STATUS_CACHE_TTL_SECONDS=10

# Prober: a comma list lets one dev process act as all three regions
REGION=us-east,eu-west,ap-southeast
PROBE_CONCURRENCY=25
SIMULATED_RTT_MS=us-east:0,eu-west:38,ap-southeast:92

# Evaluator
SMTP_URL=
EMAIL_FROM="Beacon <alerts@beacon.local>"
RESOLVE_AFTER_SECONDS=180
REOPEN_WINDOW_SECONDS=900
FLAP_WINDOW_MINUTES=20
FLAP_THRESHOLD=4
FLAPPING_PAGE_DELAY_MINUTES=10

# Web
API_INTERNAL_URL=http://127.0.0.1:8111
BROWSER_API_URL=http://localhost:8111
# Development only: signs the console in automatically. Ignored when NODE_ENV=production.
BEACON_API_KEY=bk_demo_acme_local_development_key
STATUS_REVALIDATE_SECONDS=60

# Chaos target and demo seed
CHAOS_PORT=5511
CHAOS_URL=http://127.0.0.1:5511
# Required by the chaos target in production; optional in development.
CHAOS_ADMIN_TOKEN=
DEMO_API_KEY=bk_demo_acme_local_development_key
SEED_DATABASE_TCP=127.0.0.1:27111
SEED_CACHE_TCP=127.0.0.1:6411

# CLI
BEACON_API_URL=http://localhost:8111
