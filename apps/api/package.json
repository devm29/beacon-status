{
  "name": "@beacon/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=@beacon/source --env-file-if-exists=../../.env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@beacon/core": "workspace:*",
    "@beacon/shared": "workspace:*",
    "cors": "^2.8.5",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "mongoose": "^8.24.4",
    "pino-http": "^11.0.0",
    "rate-limit-redis": "^6.0.2",
    "socket.io": "^4.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "vitest": "^3.2.7"
  }
}
