{
  "name": "@beacon/prober",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=@beacon/source --env-file-if-exists=../../.env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@beacon/core": "workspace:*",
    "@beacon/shared": "workspace:*",
    "bullmq": "^5.81.5",
    "zod": "^4.6.7",
    "mongoose": "^8.24.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "vitest": "^3.2.7"
  }
}
