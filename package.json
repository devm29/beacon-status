{
  "name": "beacon",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "infra:up": "./scripts/infra.sh up",
    "infra:down": "./scripts/infra.sh down",
    "dev": "./scripts/dev.sh",
    "build": "pnpm -r --workspace-concurrency=1 build",
    "typecheck": "pnpm --filter @beacon/shared build && pnpm -r typecheck",
    "lint": "eslint . --max-warnings=0",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "seed": "pnpm --filter @beacon/core seed",
    "chaos": "./scripts/chaos.sh",
    "beacon": "tsx --conditions=@beacon/source --env-file-if-exists=.env packages/cli/src/main.ts",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@next/eslint-plugin-next": "^15.5.4",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
